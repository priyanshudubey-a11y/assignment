{
  "name": "quote-portal-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen:api": "openapi-typescript ../../plans/openapi.yaml -o src/api/schema.d.ts",
    "dev": "vite",
    "mock": "node mock/server.mjs",
    "dev:mock": "node scripts/dev-with-mock.mjs",
    "prebuild": "npm run gen:api",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  }
}
